# Environment configuration
# Copy to .env and fill in your API keys. Every .env* file except this one is
# ignored by git.

# --- Provider keys -------------------------------------------------------------
# gpt-5-mini through Azure OpenAI (the paper's runs)
# AZURE_API_KEY=<your key>
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/
# AZURE_API_VERSION=2024-12-01-preview
# The judge (openai/gpt-4.1)
# OPENAI_API_KEY=<your key>
# Claude Sonnet 5.5: keys go in .env.anthropic as ANTHROPIC_API_KEY_<n>;
# choose the slot a run may spend.
# ANTHROPIC_KEY_SLOT=1

# --- Models ----------------------------------------------------------------------
# All four slots point at one model in the controlled grid.
# PREPROCESS_MODEL=azure/gpt-5-mini
# EVALUATE_MODEL=azure/gpt-5-mini
# GENERATE_MODEL=azure/gpt-5-mini
# AGENT_MODEL=azure/gpt-5-mini

# --- Embedding model (the paper's; local, no key) ------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Rate limit (optional) ---------------------------------------------------
# Default: 3 retries.
# LLM_NUM_RETRIES=12

# --- Experiment ------------------------------------------------------------------
# EXPERIMENT_SEED=42
# LOG_LEVEL=INFO

# --- Reproducibility (paper runs) ---------------------------------------------
# Disable the DSPy response cache; required whenever latency is reported.
# DISABLE_LLM_CACHE=true
# Snapshot each model must answer with (response.model). The run aborts before
# the first question if the provider reports a different one. Comma-separated.
# LLM_EXPECTED_RESPONSE_MODELS=azure/gpt-5-mini=gpt-5-mini-2025-08-07
# Cap Naive RAG and CRAG-style at RETRIEVAL_MAX_PASSAGES too (the controlled grid).
# Off by default: the uncontrolled March 2026 runs gave them all top_k=50 passages.
# RETRIEVAL_MAX_PASSAGES_ALL_PIPELINES=true
